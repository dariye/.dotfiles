#!/bin/bash
# Optimized for Apple Silicon Mac (M-series)
# Based on Thoughtbot's laptop script and original setup

HOMEBREW_PREFIX="/opt/homebrew"
XDG_CONFIG_HOME="$HOME/.config"

set -euo pipefail
IFS=$'\n\t'

fancy_echo() {
  printf "\\n%b\\n" "$1"
}

if [ "$(uname -m)" != "arm64" ]; then
  fancy_echo "⚠️  This script is optimized for Apple Silicon (M-series) Macs"
  exit 1
fi

if [ "$(sw_vers -productVersion | cut -d. -f1)" -lt "14" ]; then
  fancy_echo "⚠️  This script requires macOS Sonoma (14.0) or later"
  exit 1
fi

mkdir -p "$XDG_CONFIG_HOME"

if ! command -v brew >/dev/null; then
  fancy_echo "🍺 Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

eval "$($HOMEBREW_PREFIX/bin/brew shellenv)"

if ! xcode-select -p &>/dev/null; then
  fancy_echo "Installing Xcode Command Line Tools..."
  xcode-select --install
  until xcode-select -p &>/dev/null; do
    sleep 5
  done
fi

fancy_echo "🍻 Installing Homebrew packages..."
brew bundle --file=./Brewfile

fancy_echo "🐠 Setting up fish shell..."
if ! grep -q "$HOMEBREW_PREFIX/bin/fish" /etc/shells; then
  echo "$HOMEBREW_PREFIX/bin/fish" | sudo tee -a /etc/shells
fi
if [ "$SHELL" != "$HOMEBREW_PREFIX/bin/fish" ]; then
  chsh -s "$HOMEBREW_PREFIX/bin/fish"
fi

fancy_echo "🔗 Linking dotfiles..."
env RCRC="$HOME/.dotfiles/rcrc" rcup -f

fancy_echo "📦 Installing language runtimes via mise..."
# postgres is built from source and needs pkg-config plus keg-only icu4c.
ICU_PREFIX="$(brew --prefix icu4c 2>/dev/null || true)"
if [ -n "$ICU_PREFIX" ]; then
  export PKG_CONFIG_PATH="$ICU_PREFIX/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
fi
mise trust "$XDG_CONFIG_HOME/mise/config.toml"
mise install

# Gas Town (gt) — not available via Homebrew. `go install` yields a binary that
# refuses to run ("built with 'go build' directly"); only the Makefile sets the
# BuiltProperly ldflag, and `make install` targets ~/.local/bin.
fancy_echo "⛽ Installing Gas Town..."
GASTOWN_SRC="$(mktemp -d)/gastown"
git clone --depth 1 https://github.com/steveyegge/gastown.git "$GASTOWN_SRC"
mise exec go -- make -C "$GASTOWN_SRC" install
rm -rf "$GASTOWN_SRC"

# gt initialises a beads (dolt) DB and needs an identity, which it reads from
# git config if dolt has none of its own.
if ! git config --global user.name >/dev/null 2>&1; then
  fancy_echo "⚠️  Set your git identity before Gas Town can initialise beads:"
  fancy_echo "    git config --global user.name \"Your Name\""
  fancy_echo "    git config --global user.email \"you@example.com\""
  exit 1
fi

# Pass the HQ path explicitly: with no argument gt uses the CURRENT directory,
# which would make ~/.dotfiles itself the town root.
GT_HQ="${GT_HQ:-$HOME/gt}"
if [ ! -d "$GT_HQ/mayor" ]; then
  "$HOME/.local/bin/gt" install "$GT_HQ" --shell
else
  fancy_echo "   Gas Town HQ already present at $GT_HQ"
fi

fancy_echo "✅ Setup complete!"
