#!/bin/bash
# Optimized for Apple Silicon Mac (M-series)
# Based on Thoughtbot's laptop script and original setup

HOMEBREW_PREFIX="/opt/homebrew"
XDG_CONFIG_HOME="$HOME/.config"

set -euo pipefail
IFS=$'\n\t'

fancy_echo() {
  printf "\\n%b\\n" "$1"
}

if [ "$(uname -m)" != "arm64" ]; then
  fancy_echo "⚠️  This script is optimized for Apple Silicon (M-series) Macs"
  exit 1
fi

if [ "$(sw_vers -productVersion | cut -d. -f1)" -lt "14" ]; then
  fancy_echo "⚠️  This script requires macOS Sonoma (14.0) or later"
  exit 1
fi

mkdir -p "$XDG_CONFIG_HOME"

if ! command -v brew >/dev/null; then
  fancy_echo "🍺 Installing Homebrew..."
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi

eval "$($HOMEBREW_PREFIX/bin/brew shellenv)"

if ! xcode-select -p &>/dev/null; then
  fancy_echo "Installing Xcode Command Line Tools..."
  xcode-select --install
  until xcode-select -p &>/dev/null; do
    sleep 5
  done
fi

fancy_echo "🍻 Installing Homebrew packages..."
brew bundle --file=./Brewfile

fancy_echo "🐠 Setting up fish shell..."
if ! grep -q "$HOMEBREW_PREFIX/bin/fish" /etc/shells; then
  echo "$HOMEBREW_PREFIX/bin/fish" | sudo tee -a /etc/shells
fi
if [ "$SHELL" != "$HOMEBREW_PREFIX/bin/fish" ]; then
  chsh -s "$HOMEBREW_PREFIX/bin/fish"
fi

fancy_echo "🔗 Linking dotfiles..."
env RCRC="$HOME/workspace/dotfiles/rcrc" rcup -f

fancy_echo "📦 Installing language runtimes via mise..."
# postgres is built from source and needs pkg-config plus keg-only icu4c.
ICU_PREFIX="$(brew --prefix icu4c 2>/dev/null || true)"
if [ -n "$ICU_PREFIX" ]; then
  export PKG_CONFIG_PATH="$ICU_PREFIX/lib/pkgconfig:${PKG_CONFIG_PATH:-}"
fi
mise trust "$XDG_CONFIG_HOME/mise/config.toml"
mise install

# moi (moi.computer) — local agent workspace UI, one server for all workspaces.
# Installed globally with bun (which mise provides); the launchd service starts
# it on login and keeps it running, bound to localhost only. Per-project setup
# stays manual: `moi init` inside each repo under ~/workspace.
fancy_echo "🖥  Installing moi..."
# The running server must go down before (re)installing — so only install
# when absent; updates are manual (`moi update --check`).
if [ ! -x "$HOME/.bun/bin/moi" ]; then
  mise exec bun -- bun i -g moi-computer@latest
  "$HOME/.bun/bin/moi" service install
else
  fancy_echo "   moi already installed ($("$HOME/.bun/bin/moi" --version))"
fi

# beads (bd) + Dolt — the memory layer for coding agents. bd embeds its own
# Dolt engine; the Brewfile's dolt CLI is for inspecting and backing up the
# databases. Dolt commits need an identity (falls back to git config, set
# explicitly here so it survives git config changes).
fancy_echo "📿 Configuring Dolt identity for beads..."
if ! dolt config --list 2>/dev/null | grep -q "^user.name"; then
  dolt config --global --add user.name "$(git config --global user.name)"
  dolt config --global --add user.email "$(git config --global user.email)"
fi
# Per repo, kept invisible to collaborators via .git/info/exclude:
#   bd init --stealth && bd setup claude --stealth
#   bd dolt remote add origin file://$HOME/workspace/.beads-remotes/<name>
# (bd setup --stealth does not exclude CLAUDE.md/.claude — add those to
# .git/info/exclude manually in repos with upstreams.)
# Memory syncs with `bd dolt push/pull` against those file:// remotes, which
# Syncthing carries between machines — NEVER against work git remotes.
# Telemetry is disabled in config/bd/config.yaml (rcup links it to
# ~/.config/bd/config.yaml).

# ~/workspace — the root every project repo lives under (each its own git
# repo + moi workspace; see the workspace README). Seed files come from
# templates/workspace; the metadata repo is local-only per machine, and the
# actual MOI/beads state arrives via Syncthing pairing.
fancy_echo "🗂  Bootstrapping ~/workspace..."
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
mkdir -p "$HOME/workspace"
for f in README.md .gitignore .stignore; do
  if [ ! -f "$HOME/workspace/$f" ]; then
    cp "$SCRIPT_DIR/templates/workspace/$f" "$HOME/workspace/$f"
  fi
done
if [ ! -d "$HOME/workspace/.git" ]; then
  git -C "$HOME/workspace" init -q
  git -C "$HOME/workspace" add -A
  git -C "$HOME/workspace" commit -qm "Bootstrap workspace metadata"
fi

# Syncthing — p2p sync for the ~/workspace MOI layer, GUI on 127.0.0.1:8384.
# The .stignore allowlist (kept in the workspace repo) syncs only .moi-objects
# and workspace metadata — never code repos, which sync via their own remotes.
fancy_echo "🔄 Starting Syncthing..."
if ! brew services list | grep -Eq "^syncthing\s+started"; then
  brew services start syncthing
fi
fancy_echo "   Pair devices at http://127.0.0.1:8384 and share the workspace-moi folder (path: ~/workspace) to receive .moi-objects and .beads-remotes."

fancy_echo "✅ Setup complete!"
