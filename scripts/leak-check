#!/bin/bash
# Fail if anything employer-specific, secret-like or machine-specific is about
# to land in this PUBLIC repo. Used by .githooks/pre-commit (staged files) and
# by CI (whole tree). Allowlist exact lines in .leak-allow.
#
#   scripts/leak-check            # whole tree
#   scripts/leak-check --staged   # files staged for commit
#   scripts/leak-check <file>...  # given files
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"

PATTERNS=(
  # employer / work-internal
  'e-conomic' 'visma' '@economic' 'ai-agent-eva' 'zenith' 'intercom'
  'identity ?server' 'ai_agent_eva' 'eva-token' '\beva\b' 'monolith/' 'inject-vault' 'contextvault'
  '"environment": \['          # claude autoMode environment block
  # secrets
  'ghp_[A-Za-z0-9]{20,}' 'gh[ousr]_[A-Za-z0-9]{20,}' 'sk-[A-Za-z0-9_-]{16,}'
  'AKIA[0-9A-Z]{16}' 'BEGIN (RSA |OPENSSH |EC )?PRIVATE KEY'
  '(api[_-]?key|secret|token|password)["'"'"']?\s*[:=]\s*["'"'"']?[A-Za-z0-9/+_-]{12,}'
  'CLOUDFLARE_[A-Z_]*TOKEN' 'EVA_CLIENT'
  # machine / identity specific
  '/Users/[a-z]' '[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[a-z]{2,}'
  '[0-9]{8,}'                  # account numbers, ids
)
RE="$(IFS='|'; echo "${PATTERNS[*]}")"

MODE=tree
if [ "${1:-}" = "--staged" ]; then
  MODE=staged; FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
elif [ $# -gt 0 ]; then
  FILES="$(printf '%s\n' "$@")"
else
  FILES="$(git ls-files)"
fi

ALLOW=.leak-allow
hits=0
while IFS= read -r f; do
  [ -n "$f" ] && [ -f "$f" ] || continue
  case "$f" in *.png|*.jpg|*.lock.json|$ALLOW|scripts/leak-check) continue;; esac
  if [ "$MODE" = staged ]; then src() { git show ":$f"; }; else src() { cat "$f"; }; fi
  while IFS= read -r line; do
    if [ -f "$ALLOW" ] && grep -qxF -- "${line#*:}" "$ALLOW"; then continue; fi
    printf '%s:%s\n' "$f" "$line"; hits=$((hits+1))
  done < <(src | grep -niE -- "$RE" || true)
done <<< "$FILES"

if [ "$hits" -gt 0 ]; then
  echo "leak-check: $hits suspicious line(s). Remove them, or add the exact line to $ALLOW if it is genuinely public." >&2
  exit 1
fi
echo "leak-check: clean"
