#!/bin/bash
# Health check for the ~/workspace setup. Read-only; prints one line per check
# and exits 1 if anything failed. Run after moving things around, and monthly
# via the admin skill's due check.
#
#   scripts/doctor         # human output
#   scripts/doctor --quiet # failures only
set -uo pipefail
QUIET=0; [ "${1:-}" = "--quiet" ] && QUIET=1
# The work root defaults to ~/workspace/work; override with WORKSPACE_WORK_ROOT
# (set it in ~/.config/fish/local.fish, never here).
W="$HOME/workspace"; WORK="${WORKSPACE_WORK_ROOT:-$W/work}"; PERS="$W/personal"; DOT="$W/dotfiles"; WORKNAME="$(basename "$WORK")"
fail=0
ok()   { [ $QUIET = 1 ] || printf '  ok    %s\n' "$1"; }
bad()  { printf '  FAIL  %s\n' "$1"; fail=$((fail+1)); }
warn() { printf '  warn  %s\n' "$1"; }
check(){ if eval "$2"; then ok "$1"; else bad "$1"; fi; }   # name, test expression

echo "workspace layout"
check "\$HOME/workspace holds exactly personal/ $WORKNAME/ dotfiles/" \
  '[ "$(ls -1 "$W" | sort | tr "\n" " ")" = "$(printf "%s\n" dotfiles personal "$WORKNAME" | sort | tr "\n" " ")" ]'
check "$WORKNAME/ metadata repo has no git remote" \
  '[ -d "$WORK/.git" ] && [ -z "$(git -C "$WORK" remote)" ]'
check "personal/ is a git repo with a remote" \
  '[ -n "$(git -C "$PERS" remote 2>/dev/null)" ]'

echo "dotfiles links (rcm)"
if command -v lsrc >/dev/null; then
  while IFS=: read -r dst src; do
    if [ -L "$dst" ] && [ "$(readlink "$dst")" = "$src" ]; then ok "$dst"; else bad "$dst not linked to $src"; fi
  done < <(env RCRC="$DOT/rcrc" lsrc)
else warn "rcm not installed"; fi
check "\$HOME/.claude/settings.json is a plain file (seeded, not linked)" \
  '[ -f "$HOME/.claude/settings.json" ] && [ ! -L "$HOME/.claude/settings.json" ]'

echo "claude skills"
for s in "$PERS"/skills/*/; do
  n="$(basename "$s")"; link="$HOME/.claude/skills/$n"
  t="$(readlink "$link" 2>/dev/null || true)"
  if [ -L "$link" ] && { [ "$t" = "$s" ] || [ "$t" = "${s%/}" ]; }; then ok "$n -> personal/skills"
  elif [ -d "$link" ]; then bad "$n is a COPY in ~/.claude/skills (should be a symlink)"
  else bad "$n not linked into ~/.claude/skills"; fi
done

echo "moi"
REG="$HOME/Library/Application Support/moi/workspaces.json"
if [ -f "$REG" ]; then
  while IFS= read -r p; do
    if [ -d "$p" ]; then ok "workspace $p"; else bad "registered workspace path missing: $p"; fi
  done < <(jq -r '.[].path' "$REG")
else warn "moi registry not found"; fi
if command -v moi >/dev/null || [ -x "$HOME/.bun/bin/moi" ]; then
  MOI="$(command -v moi || echo "$HOME/.bun/bin/moi")"
  st="$("$MOI" status 2>&1)"
  if echo "$st" | grep -q "Server is running"; then ok "moi server running"; else bad "moi server not running"; fi
  if echo "$st" | grep -q "update available"; then warn "moi update available"; fi
  if "$MOI" update --check 2>&1 | grep -q "update available"; then warn "$("$MOI" update --check 2>&1 | grep 'update available' | sed 's/^ *//')"; fi
else warn "moi not installed"; fi

echo "beads remotes"
# The URL Dolt actually pushes to lives inside the embedded database, not in
# .beads/config.yaml, so ask bd rather than grepping the file.
for cfg in "$WORK"/*/.beads/config.yaml; do
  [ -f "$cfg" ] || continue
  repo="$(dirname "$(dirname "$cfg")")"; n="$(basename "$repo")"
  if command -v bd >/dev/null; then
    r="$(cd "$repo" && bd dolt remote list 2>/dev/null | awk '$1=="origin"{print $2}')"
  else
    r="$(grep -o 'file://[^"]*' "$cfg" | head -1)"
  fi
  d="${r#file://}"
  if [ -z "$r" ]; then bad "$n: no beads origin remote"
  elif [ -d "$d" ]; then ok "$n -> $d"
  else bad "$n: beads remote missing: $r"; fi
done

echo "syncthing"
ST="$HOME/Library/Application Support/Syncthing/config.xml"
if [ -f "$ST" ]; then
  p="$(grep -o 'id="workspace-moi"[^>]*path="[^"]*"' "$ST" | sed 's/.*path="//; s/"$//')"
  check "workspace-moi folder path is $WORKNAME/ (is: ${p:-unset})" '[ "${p%/}" = "$WORK" ]'
  if brew services list 2>/dev/null | grep -Eq "^syncthing\s+started"; then ok "syncthing service started"; else bad "syncthing service not started"; fi
else warn "syncthing config not found"; fi

echo "leak guard"
check "dotfiles pre-commit hook path set" '[ "$(git -C "$DOT" config core.hooksPath)" = ".githooks" ]'
check "personal pre-commit hook path set" '[ "$(git -C "$PERS" config core.hooksPath)" = ".githooks" ]'

echo
if [ $fail -gt 0 ]; then echo "doctor: $fail check(s) failed"; exit 1; else echo "doctor: all checks passed"; fi
