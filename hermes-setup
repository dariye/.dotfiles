#!/bin/bash
# Opt-in Hermes Agent (NousResearch) install — deliberately NOT part of
# mac-setup: Hermes is on trial, and on a work machine an autonomous agent
# gets adopted on purpose, not by default.
set -euo pipefail

fancy_echo() {
  printf "\\n%b\\n" "$1"
}

command -v git >/dev/null || { fancy_echo "⚠️  git is required"; exit 1; }

# Download the installer to a file instead of curl|bash so it can be read
# before it runs.
INSTALLER="$(mktemp -d)/hermes-install.sh"
curl -fsSL https://hermes-agent.nousresearch.com/install.sh -o "$INSTALLER"
fancy_echo "📜 Installer saved to:\\n   $INSTALLER\\n\\nReview it, then press Enter to run it (Ctrl-C to abort)."
read -r
bash "$INSTALLER"

fancy_echo "✅ Hermes installed. House rules for this setup:

  1. Run \`hermes setup\` to pick a provider/model (needs ≥64K context).
  2. Do NOT run \`hermes gateway setup\` — no messaging gateways on a
     work machine.
  3. Memory: ~/.hermes is Hermes' own scratch. beads (bd) stays the
     canonical memory layer — see 'The agent's brain' in the README.
  4. Per repo where Hermes should drive the workspace UI:
     \`moi init --harness=hermes\`. beads has no hermes recipe yet;
     Hermes reads the AGENTS.md that \`bd setup\` maintains."
